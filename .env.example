# The admin API. Server-side only — there is deliberately no NEXT_PUBLIC_ variant.
# A browser cannot hold a secret, and exposing this base URL to the bundle is what
# forces the admin to stay publicly reachable.
# The ADMIN's origin plus /api/v1 — never the storefront's (its proxy passes only
# public calls, so sign-in, reset and create-account would all fail).
ADMIN_API_BASE_URL=https://admin.example.com/api/v1

# Optional. Identifies this deployment to the admin so it can resolve the right
# brand configuration. Never a provider credential.
ADMIN_API_TOKEN=

# Public origin of THIS app, no trailing slash. Used for absolute URLs.
PORTAL_URL=https://portal.example.com

# Secret used to sign the session cookie. Generate with `openssl rand -hex 32`.
# Unset = the app refuses to start rather than falling back to an unsigned cookie.
SESSION_SECRET=
