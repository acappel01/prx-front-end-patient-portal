# The admin API. Server-side only — there is deliberately no NEXT_PUBLIC_ variant.
# A browser cannot hold a secret, and exposing this base URL to the bundle is what
# forces the admin to stay publicly reachable.
# The ADMIN's origin plus /api/v1 — never the storefront's (its proxy passes only
# public calls, so sign-in, reset and create-account would all fail). Required: the
# server refuses to start in production unless it is an http(s) URL ending in /api/v1.
ADMIN_API_BASE_URL=https://admin.example.com/api/v1

# Optional: needed only when the admin's "Require tokens" is on for Public read. An API
# client token (admin: Users & access > API clients) with Public read, sent only on the
# anonymous /config read so the brand loads. Never a provider credential; patient calls
# carry the patient's own session token.
ADMIN_API_TOKEN=

# Required. Public origin of THIS app (scheme + host, no path), exactly as the
# browser's address bar shows it. Every route that changes something refuses a
# request whose Origin is not this one (lib/requestGuard.js), so a script on a
# sibling subdomain cannot write as a signed-in patient. Unset or invalid = the server
# refuses to start in production; in development every such request is refused with a
# 500 and the reason is logged.
PORTAL_URL=https://portal.example.com

# Required. Secret used to sign the session cookie, at least 32 bytes. Generate with
# `openssl rand -hex 32`. Unset or shorter = the server refuses to start in production
# (instrumentation.js) rather than fall back to an unsigned or weakly signed cookie.
SESSION_SECRET=

# Optional. Extra sources for one Content-Security-Policy directive, space-separated
# hosts or schemes (lib/securityHeaders.js). The policy already allows this origin and,
# for images, the admin's origin (from ADMIN_API_BASE_URL). Set CSP_IMG_SRC when brand
# uploads are served from a storage or CDN host instead. Also: CSP_CONNECT_SRC,
# CSP_SCRIPT_SRC, CSP_STYLE_SRC, CSP_FONT_SRC, CSP_FRAME_SRC, CSP_MEDIA_SRC, CSP_WORKER_SRC.
CSP_IMG_SRC=

# Optional. Device features this origin may use (e.g. "camera microphone" once video
# visits ship). Unset = camera, microphone and geolocation are off.
PERMISSIONS_ALLOW=
